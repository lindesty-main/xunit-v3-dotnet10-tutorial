<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <!-- 本章的被测代码在测试程序集里(Production/ 目录),
       而 IncludeTestAssembly 默认是 false,不开启就没有任何数据(第 10 章 10.5) -->
  <IncludeTestAssembly>True</IncludeTestAssembly>
  <CodeCoverage>
    <!-- 只统计被测代码所在的命名空间,测试与演示代码不进覆盖率 -->
    <Functions>
      <Include>
        <Function>^Ch11\.Ci\.Production\..*</Function>
      </Include>
    </Functions>
  </CodeCoverage>
</Configuration>
